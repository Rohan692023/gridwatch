# Server
PORT=5000
NODE_ENV=development

# Database
MONGO_URI=mongodb://127.0.0.1:27017/gridwatch
# If on a network that blocks SRV lookups (mongodb+srv://), use the
# standard (non-SRV) connection string from Atlas instead.

# Auth
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
JWT_EXPIRES_IN=1d
JWT_REFRESH_SECRET=replace-with-a-different-random-secret-of-at-least-32-characters
JWT_REFRESH_EXPIRES_IN=7d

# CORS
CLIENT_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# Simulation
DEMAND_TICK_MS=4000

# Initial admin seed (use a unique strong password)
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=replace-with-a-strong-password
