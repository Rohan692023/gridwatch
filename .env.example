# Docker Compose environment
# Copy to .env and replace every production value.

MONGO_URI=mongodb://mongo:27017/gridwatch

# Generate two different values with:
# node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
JWT_REFRESH_SECRET=replace-with-a-different-random-secret-of-at-least-32-characters
JWT_REFRESH_EXPIRES_IN=7d

# Public URLs
CLIENT_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
VITE_API_URL=http://localhost:5000/api
VITE_SOCKET_URL=http://localhost:5000

# Simulation
DEMAND_TICK_MS=4000

# Only needed when running the seed command
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=replace-with-a-strong-password
